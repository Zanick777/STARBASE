{
  "name": "starbase",
  "productName": "STARBASE",
  "version": "1.0.0",
  "description": "STARBASE \u2014 personal mission-control command center",
  "author": "Zack McCain",
  "license": "MIT",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run build && electron-builder --win portable --x64 --publish never",
    "dist:installer": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:all": "npm run build && electron-builder --win nsis portable --x64 --publish never"
  },
  "build": {
    "appId": "com.zack.starbase",
    "productName": "STARBASE",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "STARBASE.exe"
    },
    "linux": {
      "target": "dir",
      "icon": "build/icon.png"
    },
    "publish": null,
    "nsis": {
      "artifactName": "STARBASE-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "STARBASE",
      "uninstallDisplayName": "STARBASE",
      "deleteAppDataOnUninstall": false
    },
    "electronFuses": {
      "version": "1",
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    }
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2"
  }
}
